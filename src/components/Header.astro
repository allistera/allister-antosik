---
import Search from './Search.astro';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home', current: pathname === '/' },
  { href: '/blog/', label: 'Blog', current: pathname.startsWith('/blog') },
];
const linkClass = 'text-zinc-300 hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 p-1 rounded aria-[current=page]:text-emerald-400';
---
<header
  class="py-6 border-b border-zinc-800 flex justify-between items-center w-full gap-4"
  data-pagefind-ignore
>
  <a
    href="/"
    class="flex items-center gap-3 text-xl font-bold tracking-wider text-emerald-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 p-1 rounded"
  >
    <img
      src="/logo-72.webp"
      alt="Allister Antosik logo"
      width="36"
      height="36"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="h-9 w-9 rounded-lg border border-zinc-800 bg-zinc-950 object-cover"
    />
    <span class="hidden sm:inline">&gt;_ ALLISTER ANTOSIK</span>
    <span class="sm:hidden" aria-hidden="true">&gt;_ AA</span>
  </a>
  <div class="flex flex-1 items-center justify-end gap-3 sm:gap-4 min-w-0">
    <div class="flex min-w-[6rem] flex-1 justify-end sm:max-w-md lg:max-w-lg xl:max-w-xl">
      <Search />
    </div>
    <nav class="flex shrink-0 gap-3 sm:gap-5" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} class={linkClass} aria-current={link.current ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
