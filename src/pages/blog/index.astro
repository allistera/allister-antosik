---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPublishedPosts, readingTimeMinutes } from '../../lib/posts';

const posts = (await getPublishedPosts()).map((post) => ({
  ...post,
  readingTime: `${readingTimeMinutes(post.body)} min read`,
}));

// Collect all unique tags
const allTags = Array.from(new Set(posts.flatMap((post) => post.data.tags)));
---

<Layout
  title="Allister Antosik - Lead SRE & AIOps Blog"
  description="Deep dives, architectural reviews, and guides on cloud infrastructure reliability, automation, and anomaly detection from a Lead SRE & AIOps Engineer."
>
  <Header />

  <main id="main-content" class="py-12 flex-1 flex flex-col gap-8 w-full" data-pagefind-body>
    <section class="flex flex-col gap-4">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
        <div class="flex flex-col gap-4">
          <h1 class="text-4xl font-extrabold tracking-tight text-emerald-400 text-balance">
            &gt;_ SRE & AIOps Insights
          </h1>
          <p class="text-zinc-400 max-w-2xl leading-relaxed">
            Deep dives, architectural reviews, and guides on cloud infrastructure reliability, automation, and anomaly detection.
          </p>
        </div>
        <a
          href="/rss.xml"
          class="text-sm font-mono text-emerald-400 hover:text-emerald-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded p-1 self-start sm:self-auto"
        >
          RSS feed →
        </a>
      </div>
    </section>

    <!-- Tag Cloud -->
    {allTags.length > 0 && (
      <section class="flex flex-wrap gap-2 py-2 border-y border-zinc-900" role="group" aria-label="Filter posts by tag">
        <span class="text-xs text-zinc-400 font-mono self-center mr-2" aria-hidden="true">Filter by Tag:</span>
        <button
          type="button"
          class="tag-filter-btn px-2.5 py-1 text-xs font-mono rounded bg-emerald-500 text-zinc-950 font-bold hover:bg-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
          data-tag="all"
          aria-pressed="true">
          [ All ]
        </button>
        {allTags.map(tag => (
          <button
            type="button"
            class="tag-filter-btn px-2.5 py-1 text-xs font-mono rounded bg-zinc-900 text-zinc-400 border border-zinc-800 hover:border-emerald-500 hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
            data-tag={tag}
            aria-pressed="false">
            #{tag}
          </button>
        ))}
      </section>
    )}

    <!-- Posts Grid -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full" id="blog-posts-list">
      {posts.length === 0 ? (
        <div class="col-span-full text-center text-zinc-400 font-mono py-12">
          No articles published yet.
        </div>
      ) : (
        posts.map(post => (
          <article 
            class="blog-post-card p-6 rounded bg-zinc-900 border border-zinc-800 flex flex-col justify-between gap-4 hover:border-emerald-500 transition-colors"
            data-tags={JSON.stringify(post.data.tags)}>
            <div class="flex flex-col gap-2">
              <div class="flex justify-between items-center text-xs text-zinc-400 font-mono">
                <span>{new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                <span class="reading-time">{post.readingTime}</span>
              </div>
              <a href={`/blog/${post.id}/`} class="group">
                <h2 class="text-xl font-bold text-zinc-100 font-mono tracking-wide group-hover:text-emerald-400 transition-colors text-balance">
                  {post.data.title}
                </h2>
              </a>
              <p class="text-sm text-zinc-400 leading-relaxed">
                {post.data.description}
              </p>
            </div>

            <div class="flex flex-wrap gap-2 pt-4 border-t border-zinc-800">
              {post.data.tags.map(tag => (
                <span class="blog-card-tag px-2 py-0.5 text-xs font-mono rounded bg-zinc-950 text-emerald-400 border border-zinc-800">
                  #{tag}
                </span>
              ))}
            </div>
          </article>
        ))
      )}
    </section>
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const filterButtons = document.querySelectorAll('.tag-filter-btn');
      const posts = document.querySelectorAll('.blog-post-card');

      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const selectedTag = btn.getAttribute('data-tag');

          // Highlight selected filter button
          filterButtons.forEach(b => {
            const selected = b === btn;
            b.setAttribute('aria-pressed', String(selected));
            if (selected) {
              b.classList.add('bg-emerald-500', 'text-zinc-950', 'font-bold');
              b.classList.remove('bg-zinc-900', 'text-zinc-400', 'border-zinc-800');
            } else {
              b.classList.remove('bg-emerald-500', 'text-zinc-950', 'font-bold');
              b.classList.add('bg-zinc-900', 'text-zinc-400', 'border-zinc-800');
            }
          });

          // Filter posts
          posts.forEach(post => {
            if (selectedTag === 'all') {
              post.classList.remove('hidden');
            } else {
              const postTags = JSON.parse(post.getAttribute('data-tags') || '[]');
              if (postTags.includes(selectedTag)) {
                post.classList.remove('hidden');
              } else {
                post.classList.add('hidden');
              }
            }
          });
        });
      });
    });
  </script>

  <Footer />
</Layout>
