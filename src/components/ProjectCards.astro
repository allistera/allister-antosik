---
const projects = [
  {
    name: 'monzo-mcp',
    description: [
      "Exposes Monzo's API to MCP clients (Claude Desktop, etc.) over stdio. Authenticates via OAuth 2.0 and persists refresh tokens locally so the server can renew access tokens automatically.",
      'This can run in either read only (default) or write mode, allowing users to list transactions or move money into or out of a pot (deposit / withdraw).',
    ],
    url: 'https://github.com/allistera/monzo-mcp',
    language: 'TypeScript',
  },
  {
    name: 'daily-news',
    description: [
      'A small Python service that assembles a daily email newsletter from a set of sources and delivers it with Resend. It runs every morning via GitHub Actions (and can be triggered manually).',
      "Each source returns the previous day's top items, the items are rendered into a Hacker-News-style HTML template, and the result is emailed.",
    ],
    url: 'https://github.com/allistera/daily-news',
    language: 'Python',
  },
  {
    name: 'pyscrypt-manager',
    description: [
      'A sleek, modern Home Assistant user interface and custom Lovelace card to manage, list, configure, and execute pyScripts on Home Assistant natively.',
    ],
    url: 'https://github.com/allistera/pyscrypt-manager',
    language: 'Python',
  },
  {
    name: 'github-smash',
    description: [
      'Fed up of having hundreds of GitHub repositories from crazy experiments and side projects that went nowhere? This GitHub Action will delete all your repositories in one go, leaving only the ones you want to keep.',
      'It can also delete forks, archived repos, and repos with a certain prefix or suffix.',
    ],
    url: 'https://github.com/allistera/github-smash',
    language: 'GitHub Actions, YAML',
  },
  {
    name: 'Bookmark-AI',
    description: [
      'A Chrome extension that uses AI to automatically save, categorize, and organize your bookmarks into your own hierarchical folder structure.',
      'It also provides Self-Healing Health Checks: scan, identify, and bulk-resolve dead links, redirects, changed page titles, stale content, and offline domains.',
    ],
    sourceLabel: 'Source and releases',
    url: 'https://github.com/allistera/Bookmark-AI',
    language: 'JavaScript',
  },
  {
    name: 'Githup',
    description: [
      'Githup is a Python command-line tool that uses a pool of Claude Agent SDK workers to maintain multiple GitHub repositories in parallel. It reads a list of repositories and settings from YAML or CLI flags, clones each target into an isolated workspace, detects its dependency tooling, updates compatible dependencies and lockfiles, checks and remediates Dependabot alerts where possible, then opens a pull request rather than touching the default branch. By default it also waits for PR CI checks and asks the worker to fix failures, while dry-run mode provides a safe analysis-only preview.',
    ],
    url: 'https://github.com/allistera/githup',
    language: 'Python',
  },
] as const;
---

{projects.map((project) => (
  <article class="project-card p-6 rounded bg-zinc-900 border border-zinc-800 flex flex-col justify-between gap-4 hover:border-emerald-500 transition-colors">
    <div class="flex flex-col gap-2">
      <h3 class="text-xl font-bold text-zinc-100 font-mono tracking-wide">{project.name}</h3>
      <div class="project-description flex flex-col gap-2 text-sm text-zinc-400 leading-relaxed">
        {project.description.map((paragraph) => <p>{paragraph}</p>)}
        {'sourceLabel' in project && (
          <p>
            {project.sourceLabel}:{' '}
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 underline underline-offset-2 break-all">
              {project.url}
            </a>
          </p>
        )}
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-zinc-400 font-mono pt-4 border-t border-zinc-800">
      <span>Language: <strong class="text-emerald-400">{project.language}</strong></span>
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-emerald-400 hover:text-emerald-300 break-all"
      >
        allistera/{project.name}
      </a>
    </div>
  </article>
))}
