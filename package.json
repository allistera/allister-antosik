{
  "name": "bloggy",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && npm run pagefind",
    "pagefind": "pagefind --site dist && (test -d .vercel/output/static && cp -R dist/pagefind .vercel/output/static/ || true)",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint \"src/**/*.{astro,ts,mjs,js}\" --max-warnings=0",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.14",
    "@sentry/astro": "^11.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "astro-seo": "^1.2.0",
    "js-yaml": "^5.4.3",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "pagefind": "^1.5.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
}
