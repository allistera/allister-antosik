---
import { SEO } from 'astro-seo';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Optional JSON-LD object or array of objects injected as application/ld+json */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** openGraph type — default website; use article for blog posts */
  ogType?: string;
}

const site = Astro.site ?? new URL('https://allisterantosik.com');

const {
  title,
  description = 'Lead SRE & AIOps Engineer based in Edinburgh, Scotland — portfolio and blog on automation, reliability, and high-performance systems.',
  // Wide social card for OG/Twitter; override per-page when needed
  image = '/og-default.png',
  noindex = false,
  schema,
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = image.startsWith('http') ? image : new URL(image, site).href;
const isDefaultOg = image === '/og-default.png' || image.endsWith('/og-default.png');
const schemaList = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];
const telemetryEnabled = Boolean(import.meta.env.PUBLIC_SENTRY_DSN);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#09090b" />
    <meta name="msapplication-TileColor" content="#09090b" />
    <meta name="msapplication-TileImage" content="/icon-192.png" />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      openGraph={{
        basic: {
          title,
          type: ogType,
          image: ogImage,
          url: canonical,
        },
        optional: {
          description,
          siteName: 'Allister Antosik',
        },
        image: {
          url: ogImage,
          secureUrl: ogImage,
          type: 'image/png',
          width: isDefaultOg ? 1200 : 512,
          height: isDefaultOg ? 630 : 512,
          alt: 'Allister Antosik — Lead SRE & AIOps Engineer',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title,
        description,
        image: ogImage,
        imageAlt: 'Allister Antosik — Lead SRE & AIOps Engineer',
      }}
      extend={{
        link: [
          { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
          { rel: 'icon', type: 'image/png', sizes: '16x16', href: '/favicon-16.png' },
          { rel: 'icon', type: 'image/png', sizes: '32x32', href: '/favicon-32.png' },
          { rel: 'icon', type: 'image/png', sizes: '48x48', href: '/favicon-48.png' },
          { rel: 'apple-touch-icon', sizes: '180x180', href: '/apple-touch-icon.png' },
          { rel: 'manifest', href: '/site.webmanifest' },
          { rel: 'alternate', type: 'application/rss+xml', href: '/rss.xml', title: 'Allister Antosik RSS' },
        ],
      }}
    />

    {schemaList.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

  </head>
  <body class="bg-zinc-950 text-zinc-50 min-h-dvh flex flex-col w-full font-mono">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-emerald-500 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-zinc-950 focus:outline-none"
    >
      Skip to content
    </a>
    <div class="flex-1 flex flex-col w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Pagefind indexes regions marked data-pagefind-body (see page mains) -->
      <slot />
    </div>
    {telemetryEnabled && <script src="../scripts/telemetry-init.ts"></script>}
  </body>
</html>
