---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 - Page Not Found" description="Page not found." noindex={true}>
  <Header />

  <main id="main-content" class="py-12 flex-1 flex flex-col items-center justify-center gap-6 w-full text-center" data-pagefind-ignore>
    <div class="font-mono flex flex-col gap-3 items-center">
      <div class="text-6xl font-bold text-red-500 tracking-wider motion-safe:animate-pulse">
        [ 404_ ]
      </div>
      <h1 class="text-2xl font-bold text-zinc-100 mt-2">
        Error: Resource Not Found
      </h1>
      <p class="text-sm text-zinc-400 max-w-md mt-1 leading-relaxed">
        The requested path does not exist in our system registry. It may have been relocated, deleted, or is temporarily offline.
      </p>
    </div>

    <div class="mt-4 flex flex-wrap justify-center gap-3">
      <a href="/blog/" class="px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold font-mono text-sm rounded transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400">
        &gt;_ Return to Blog
      </a>
      <a href="/" class="px-5 py-2.5 border border-zinc-700 text-zinc-300 font-mono text-sm rounded hover:border-emerald-500 hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">
        Go home
      </a>
    </div>
  </main>

  <Footer />
</Layout>
